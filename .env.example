MCP_SERVER_NAME=kube-triage
MCP_HOST=127.0.0.1
MCP_PORT=8080

# The demo seed script creates this database. Runtime access is read-only.
DATABASE_URL=sqlite:///file:data/inventory.db?mode=ro&uri=true

# Use fixture without a cluster; switch to http for a real Prometheus endpoint.
PROMETHEUS_MODE=fixture
PROMETHEUS_URL=
PROMETHEUS_CLUSTER_LABEL=cluster
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_TIMEOUT_SECONDS=15
PROMETHEUS_MAX_RANGE_HOURS=24
PROMETHEUS_MIN_STEP_SECONDS=30
PROMETHEUS_MAX_RESPONSE_BYTES=2000000
PROMETHEUS_FIXTURE_FILE=./fixtures/prometheus.json
METRIC_STALE_AFTER_SECONDS=300

INVENTORY_STALE_AFTER_HOURS=168
HEALTH_RESTART_WARNING=5
HEALTH_CPU_WARNING_RATIO=0.9
HEALTH_MEMORY_WARNING_RATIO=0.9
INVENTORY_MAX_ROWS=200

SKILL_REGISTRY_DIR=./skill-registry
KNOWN_ISSUES_FILE=./known-issues/catalog.yaml
LOG_LEVEL=INFO