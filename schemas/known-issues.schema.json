{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kubernetes Operations Known Issues",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "signals", "skill_id", "status", "summary"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^KI-[0-9]{3,}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "signals": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "skill_id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
      },
      "status": {
        "enum": ["active", "monitoring", "resolved"]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}